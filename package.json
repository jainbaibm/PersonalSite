{
  "name": "jainbai-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "build": "npm run typecheck && npm run build:client && npm run build:ssr && node scripts/prerender.mjs && node scripts/check-links.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.59.0",
    "marked": "^15.0.12",
    "marked-highlight": "^2.2.4",
    "mermaid": "^11.17.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.8",
    "vite": "^6.4.4"
  }
}
